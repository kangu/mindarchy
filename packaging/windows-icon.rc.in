IDI_ICON1 ICON "@APPLICATION_ICON_WINDOWS@"

#include <windows.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @WINDOWS_VERSION@
 PRODUCTVERSION @WINDOWS_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Mindarchy\0"
   VALUE "FileDescription", "Mindarchy\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "InternalName", "mindarchy\0"
   VALUE "OriginalFilename", "mindarchy.exe\0"
   VALUE "ProductName", "Mindarchy\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
