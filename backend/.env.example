# Copy to .env; chmod 600 .env. This is sourced as shell code by run.sh.
# Use your existing database and credentials. Quote values containing shell syntax.
MINDARCHY_COUCHDB_URL='http://127.0.0.1:5984'
MINDARCHY_COUCHDB_DATABASE='mindarchy-content'
MINDARCHY_COUCHDB_USER='replace-with-your-couchdb-user'
MINDARCHY_COUCHDB_PASSWORD='replace-with-your-couchdb-password'
# Keep loopback for local use; use your existing listen address for remote clients.
MINDARCHY_LISTEN_ADDR='127.0.0.1:8080'
